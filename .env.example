# ==============================================================================
# Portfolio Environment Variables
# ==============================================================================

# --- Gmail SMTP (Contact Form Server Action) ---
# Required for receiving messages and sending automated confirmations to visitors.
# Generate via: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# --- Upstash Redis (Distributed Serverless Rate Limiting) ---
# Optional for local development (safely falls back to in-memory sliding window).
# Strongly recommended for multi-region Vercel serverless deployments.
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# (Optional) Random secret salt used to one-way hash visitor IP addresses
RATE_LIMIT_SALT=replace_with_random_secret_salt_string

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://chiranthanns.vercel.app
