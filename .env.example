# ==============================================================================
# Portfolio Environment Variables — copy to .env.local for local development
# ==============================================================================

# --- Recommended: Resend API (Fast, Serverless-native, No App Password issues) ---
# 1. Sign up for free at https://resend.com
# 2. Create an API key in the Resend dashboard
# 3. Paste the key below (starts with re_...)
RESEND_API_KEY=re_your_api_key_here

# The recipient inbox that receives contact form submissions
CONTACT_OWNER_EMAIL=chiranthanns24056@gmail.com

# --- Alternative: Gmail SMTP (Nodemailer) ---
# If you prefer using Gmail SMTP instead of Resend:
# 1. Enable 2-Step Verification: myaccount.google.com -> Security -> 2-Step Verification
# 2. Generate an App Password:   myaccount.google.com -> Security -> App Passwords
# 3. Select app: "Mail", device: "Other" -> name it "Portfolio"
# 4. Copy the 16-character password below (NEVER commit actual password to git)
#
# If error 535-5.7.8 appears: the App Password was revoked by Google.
# Regenerate it and update in Vercel Project Settings -> Environment Variables.
GMAIL_USER=chiranthanns24056@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Upstash Redis (Distributed Serverless Rate Limiting) ---
# Optional for local development (falls back to in-memory sliding window).
# Strongly recommended for multi-region Vercel deployments.
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# (Optional) Random secret salt used to one-way hash visitor IP addresses
RATE_LIMIT_SALT=replace_with_a_random_secret_string

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=https://chiranthanns.vercel.app